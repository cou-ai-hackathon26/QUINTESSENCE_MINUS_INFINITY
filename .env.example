# Shongoti Environment Configuration (Synthetic/Placeholder values only)
# Copy to .env for local overrides (never commit .env)

ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/shongoti_dev.db
# For PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/shongoti
SECRET_KEY=change-this-in-production-synthetic-test-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=127.0.0.1

# External integrations (optional in Phase 01 - leave blank to indicate unconfigured)
GEMINI_API_KEY=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4096
PDF_MAX_OCR_PAGES=6
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=true
