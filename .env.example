# Shongoti Environment Configuration (Synthetic/Placeholder values only)
# Copy to .env for local overrides (never commit .env)

ENVIRONMENT=development
ALLOW_LEGACY_TEST_AUTH=false
DATABASE_URL=sqlite:///./data/shongoti_dev.db
# For PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/shongoti
SECRET_KEY=change-this-in-production-synthetic-test-key
# Production rejects the placeholder. Generate a unique value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=127.0.0.1

# External integrations (optional in Phase 01 - leave blank to indicate unconfigured)
GEMINI_API_KEY=
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4096
PDF_MAX_OCR_PAGES=6
# Run scripts/setup-semantic-model.py once before enabling; no request-time download.
SEMANTIC_ENABLED=false
SEMANTIC_MODEL_PATH=apps/api/data/models/multilingual-e5-small
EVIDENCE_STORAGE_PATH=apps/api/data/evidence
VOICE_CACHE_PATH=tmp/voice_cache
VOICE_TIMEOUT_SECONDS=25
AI_TENANT_DAILY_CALLS=200
AI_GLOBAL_DAILY_CALLS=1000
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=true
