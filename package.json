{
  "name": "shongoti",
  "version": "0.1.0",
  "private": true,
  "description": "Shongoti — Bangla-first financial workspace for MSMEs",
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"pnpm --filter @shongoti/web dev\" \"node scripts/run-python.js -m uvicorn app.main:app --app-dir apps/api --reload --port 8000\"",
    "typecheck": "pnpm --filter @shongoti/web typecheck",
    "test:domain": "node scripts/run-python.js -m pytest apps/api/tests/test_domain_contracts.py apps/api/tests/test_domain_golden.py -v",
    "test:api": "node scripts/run-python.js -m pytest apps/api/tests/ -v",
    "test:web": "pnpm --filter @shongoti/web test",
    "check:css": "node scripts/check-css.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:extension": "node scripts/runner-stub.js test:extension 14",
    "test:confidence": "node scripts/run-python.js -m pytest apps/api/tests/test_confidence_and_cases.py -v",
    "test:retrieval": "node scripts/run-python.js -m pytest apps/api/tests/test_retrieval.py -v",
    "test:agents": "node scripts/run-python.js -m pytest apps/api/tests/test_agents.py -v",
    "test:copilot": "node scripts/run-python.js -m pytest apps/api/tests/test_copilot.py -v",
    "test:buying": "node scripts/run-python.js -m pytest apps/api/tests/test_buying_desk.py -v",
    "test:workflows": "node scripts/runner-stub.js test:workflows 19",
    "test:business-help": "node scripts/runner-stub.js test:business-help 24",
    "eval:rag": "node scripts/runner-stub.js eval:rag 25",
    "eval:agents": "node scripts/runner-stub.js eval:agents 25",
    "eval:confidence": "node scripts/runner-stub.js eval:confidence 25",
    "db:migrate": "node scripts/run-python.js -m alembic -c apps/api/alembic.ini upgrade head",
    "db:check": "node scripts/run-python.js -m alembic -c apps/api/alembic.ini current",
    "build": "pnpm --filter @shongoti/web build",
    "verify:offline": "node scripts/verify-offline.js",
    "verify:integrations": "node scripts/verify-integrations.js",
    "eval:ai": "node scripts/eval-ai.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
