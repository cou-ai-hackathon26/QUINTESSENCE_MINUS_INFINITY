# Shongoti Production Environment Variables Template
# Copy to .env.production and populate before production container launch

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=shongoti
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=shongoti
DATABASE_URL=postgresql://shongoti:your_secure_db_password_here@db:5432/shongoti

# Security & Sessions
JWT_SECRET=generate_a_cryptographically_secure_random_string_min_32_chars
ENVIRONMENT=production
CORS_ORIGINS=https://app.shongoti.com,http://localhost:3000

# File Storage (Tenant Evidence & Reports)
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_BYTES=10485760

# Model Provider (Optional / Live Boundary)
# If left empty, deterministic rules & OCR boundary will be active
GEMINI_API_KEY=

# Payment Gateway (SSLCOMMERZ Sandbox or Live)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
SSLCOMMERZ_IS_SANDBOX=true

# Notification Services (SMS / Mock)
SMS_PROVIDER_KEY=
